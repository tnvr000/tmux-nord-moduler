#!/usr/bin/env bash
# lib/colors.tmux

# Nord Theme Colors used in the status bar
export NORD_BASE_BG="#2E3440"       # The main background of the tmux status line
export NORD_MODULE_BG="#4C566A"     # Bright Black (Background for date, time, etc.)
export NORD_MODULE_FG="#D8DEE9"     # Light grey/White (Text for date, time)

export NORD_ACCENT_BG="#88C0D0"     # Cyan (Background for the final module e.g., username)
export NORD_ACCENT_FG="#2E3440"     # Dark Black (Text for the final module)

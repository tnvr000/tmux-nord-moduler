#!/usr/bin/env bash
# lib/colors.tmux

export NORD_BASE_BG="black"       # Translates to #2E3440
export NORD_MODULE_BG="brightblack" # Translates to #4C566A
export NORD_MODULE_FG="white"       # Translates to #D8DEE9

export NORD_ACCENT_BG="cyan"        # Translates to #88C0D0
export NORD_ACCENT_FG="black"       # Translates to #2E3440

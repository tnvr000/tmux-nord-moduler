#!/usr/bin/env bash

THEME_NAME="oasis"

# Base / status
# Deep desert night
THEME_BASE_BG="#241A14"
THEME_BASE_FG="#E8DCC4"

THEME_STATUS_BG="#241A14"
THEME_STATUS_FG="#E8DCC4"

# Modules
# Dark sandstone
THEME_MODULE_BG="#493528"
THEME_MODULE_FG="#F3E5C8"

# General accent
# Oasis water
THEME_ACCENT_BG="#5FA89B"
THEME_ACCENT_FG="#1C1612"

# Session indicator
THEME_SESSION_BG="#C9963E"
THEME_SESSION_FG="#241A14"

# Windows
THEME_WINDOW_BG="#3B2B21"
THEME_WINDOW_FG="#CDBFA8"

# Selected window
THEME_WINDOW_CURRENT_BG="#C9963E"
THEME_WINDOW_CURRENT_FG="#241A14"

# Pane borders
THEME_PANE_BORDER="#D8DEE9"
THEME_PANE_ACTIVE_BORDER="#C9963E"

# Modes

# Normal — oasis water
THEME_MODE_NORMAL_BG="#5FA89B"

# Command — desert gold
THEME_MODE_COMMAND_BG="#D9A441"

# Copy / Tree — terracotta
THEME_MODE_COPY_BG="#B85C4B"

# Buffer / Options / Zoom — desert purple
THEME_MODE_OTHER_BG="#9A6E9E"

# Shared mode foreground
THEME_MODE_FG="#1C1612"